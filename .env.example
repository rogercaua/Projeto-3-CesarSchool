DATABASE_URL=sqlite:///./governanca.db
CORS_ORIGINS=["http://localhost:3000"]

# dev = login simulado | keycloak = valida tokens do Keycloak | ldap = bind contra um servidor LDAP
AUTH_MODE=dev
JWT_SECRET=troque-esta-chave
# Chave AES-256 das colunas cifradas (32 bytes em base64)
CRIPTO_CHAVE=ZGV2LXNvbWVudGUtdHJvcXVlLWVzdGEtY2hhdmUtMzI=

# Só para AUTH_MODE=keycloak
KEYCLOAK_ISSUER=https://sso.exemplo.gov.br/realms/saude
KEYCLOAK_AUDIENCE=
# Cliente público do front no Keycloak (Standard flow + PKCE S256)
KEYCLOAK_CLIENT_ID=govcadastral-web

# Só para AUTH_MODE=ldap (veja infra/openldap/ para subir um servidor de teste)
LDAP_URL=ldap://34.233.125.128:389
LDAP_BASE_DN=dc=governanca,dc=local
# Padrão já serve para o seed de infra/openldap; mude só se a árvore do seu LDAP for diferente.
LDAP_USER_DN_TEMPLATE=uid={username},ou=people,{base_dn}
LDAP_GROUP_SEARCH_BASE=ou=groups,{base_dn}

# Exportação de relatórios para S3 (POST /relatorios/exportar). As credenciais da AWS
# NÃO vão aqui: o boto3 já lê AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN
# do ambiente (inclusive as credenciais temporárias do AWS Academy Learner Lab).
AWS_REGION=us-east-1
S3_BUCKET=

# Autorização M2M (OAuth2 client_credentials) para POST /relatorios/exportar-m2m.
# Reaproveita o mesmo Authorization Server do SSO; vazio usa KEYCLOAK_ISSUER.
# Funciona independente de AUTH_MODE (não precisa estar em "keycloak" para os usuários).
OAUTH2_M2M_ISSUER=
# client_id (claim "azp") aceito; vazio aceita qualquer client com o escopo relatorios:exportar
OAUTH2_M2M_CLIENT_ID=
