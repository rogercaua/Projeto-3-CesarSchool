DATABASE_URL=sqlite:///./governanca.db
CORS_ORIGINS=["http://localhost:3000"]

# dev = login simulado | keycloak = valida tokens do Keycloak
AUTH_MODE=dev
JWT_SECRET=troque-esta-chave
# Chave AES-256 das colunas cifradas (32 bytes em base64)
CRIPTO_CHAVE=ZGV2LXNvbWVudGUtdHJvcXVlLWVzdGEtY2hhdmUtMzI=

# Só para AUTH_MODE=keycloak
KEYCLOAK_ISSUER=https://sso.exemplo.gov.br/realms/saude
KEYCLOAK_AUDIENCE=
# Cliente público do front no Keycloak (Standard flow + PKCE S256)
KEYCLOAK_CLIENT_ID=govcadastral-web
